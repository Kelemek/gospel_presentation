# Capacitor WebView server URL - copy to .env.capacitor and set your URL
# Used only when running: npx cap sync
#
# For iOS Simulator (local dev):
# CAPACITOR_SERVER_URL=http://localhost:3000
#
# For Android Emulator (local dev):
# CAPACITOR_SERVER_URL=http://10.0.2.2:3000
#
# For production native build:
# CAPACITOR_SERVER_URL=https://cp-church.org

CAPACITOR_SERVER_URL=https://cp-church.org
