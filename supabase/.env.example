# Supabase Edge Functions Environment Variables
# Copy this file to .env and fill in your actual values

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# Microsoft Graph API for Email (O365)
# Get these from Azure Portal: https://portal.azure.com
# 1. Register an application in Azure AD
# 2. Grant Mail.Send permission (Application type, not Delegated)
# 3. Create a client secret
# 4. Get your tenant ID from Azure AD overview
MICROSOFT_GRAPH_TENANT_ID=your_azure_tenant_id
MICROSOFT_GRAPH_CLIENT_ID=your_azure_application_client_id
MICROSOFT_GRAPH_CLIENT_SECRET=your_azure_client_secret

# Email Configuration
# The "from" address must be a valid mailbox in your O365 tenant
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Gospel Presentation App

# Application URLs
APP_URL=http://localhost:3000
APP_NAME=Gospel Presentation
